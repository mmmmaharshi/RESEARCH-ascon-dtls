## 1. Install (Task 1, via root to avoid sudo password hang)
# wsl --user root -- bash -c 'apt update && apt install -y qemu-system-arm qemu-user valgrind --no-install-recommends'
# wsl -- bash -c 'valgrind --version' -> valgrind-3.22.0
# wsl -- bash -c 'qemu-system-arm --version' -> 8.2.2

## 2. Build (WSL gcc 13.3.0, user_settings.h HAVE_ASCON)
# Direct source build (avoids -Lbuild libwolfssl.dll Windows PE):
# gcc -O2 -I. -Iwolfssl -DWOLFSSL_USER_SETTINGS tools/ascon_mask_dudect.c \
#   wolfssl/wolfcrypt/src/ascon.c wolfssl/wolfcrypt/src/memory.c \
#   wolfssl/wolfcrypt/src/logging.c wolfssl/wolfcrypt/src/error.c \
#   wolfssl/wolfcrypt/src/wc_port.c wolfssl/wolfcrypt/src/random.c \
#   wolfssl/wolfcrypt/src/sha256.c -lm -o /tmp/dudect
# gcc -O2 -I. -Iwolfssl -DWOLFSSL_USER_SETTINGS -DWOLFSSL_ASCON_32BIT \
#   [same srcs] -lm -o /tmp/dudect32
# -> /tmp/dudect 81K, /tmp/dudect32 89K

